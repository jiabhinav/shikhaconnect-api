# Hosted PostgreSQL: set DATABASE_URL instead of the separate fields below.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# DATABASE_URL takes precedence when set. Use the provider URL unchanged.

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=shikhaconnect
DATABASE_USER=shikhaconnect
# Single quotes preserve special characters such as $ and # in Compose.
DATABASE_PASSWORD='Shikshaconnect@2026'
